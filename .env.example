# Core Django
SECRET_KEY=change-me-to-a-random-secret
DJANGO_SETTINGS_MODULE=core.settings.dev
ALLOWED_HOSTS=*

# Database
DB_NAME=eventops
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Required for the AI assistant and knowledge-base embeddings
OPENAI_API_KEY=sk-...

# Optional — defaults shown
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Where the browser's own WebSocket connection reaches the seat picker.
# Dev: matches web's published port. Production: your public host/port
# behind Nginx. See README's "Development vs Production" section.
DJANGO_WS_HOST=localhost:8000

# Optional: SMTP email delivery (falls back to console logging if unset)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=secret
EMAIL_USE_TLS=True
